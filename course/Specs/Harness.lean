import Tau

/-!
# What the specification exercises share

The files in `course/Specs/` ask you to write a definition from a source: a
section of the manual (`course/architecture-manual.md`) or a file of the C++ compiler. This
file gives them three things.

* `todo` stands where your definition goes. It has a value, so the file
  compiles before you start and the tests run and disagree.
* `row` compares one value your definition gives with the value the source
  gives.
* `report` prints how many rows agree and lists the ones that do not. Put the
  cursor on a `#eval report ...` line to read it. `reportIO` does the same
  for a table that has to read files the compiler wrote.

Do not edit this file.
-/

namespace Specs

open Tau

/-- A hole for you to fill. Replace it by your definition. -/
def todo {α : Type} [Inhabited α] : α := default

instance {σ ι ο : Type} [Inhabited σ] [Inhabited ο] : Inhabited (Block σ ι ο) :=
  ⟨⟨default, fun s _ => (s, default)⟩⟩

instance : Inhabited TrapKind := ⟨.wrongSlice⟩

/-- One row of a table: what it is about, and whether your definition agrees
with the source. -/
structure Row where
  /-- What the row is about, and what was expected when it disagrees. -/
  label : String
  /-- Whether your definition gave the expected value. -/
  ok : Bool

/-- A row that compares the value your definition gave with the expected one. -/
def row {α : Type} [BEq α] [Repr α] (label : String) (got want : α) : Row :=
  if got == want then ⟨label, true⟩
  else ⟨s!"{label}: expected {repr want}, got {repr got}", false⟩

/-- Whether every row agrees. -/
def passes (rows : List Row) : Bool := rows.all (·.ok)

/-- A summary of a table, as text. -/
def summary (name : String) (rows : List Row) : String :=
  let bad := rows.filter (!·.ok)
  if bad.isEmpty then s!"{name}: all {rows.length} rows agree"
  else
    s!"{name}: {bad.length} of {rows.length} rows disagree\n" ++
      "\n".intercalate (bad.map fun r => "  " ++ r.label)

/-- Print a summary of a table. Put the cursor on the `#eval` line to read
it. -/
def report (name : String) (rows : List Row) : IO Unit :=
  IO.println (summary name rows)

/-- Print a summary of a table that has to read the compiler's files. -/
def reportIO (name : String) (rows : IO (List Row)) : IO Unit := do
  IO.println (summary name (← rows))

end Specs
