import Specify.Support.Harness

/-!
# The tables of the docs, as tests

Each function here takes a definition of one component and compares it with
the rows of that component's table in `docs/Machine.md`. A test looks only at
outputs, cycle by cycle. It never looks at the state, so you are free to
choose the state.

For most components there is a second function, ending in `Decisions`. Its
rows are cases the docs say nothing about, with the answer that the
specification in `spec/Tau/` settled on. Run it after you have written down your
own list of what the docs leave open.

`course/tests/CourseTest/Docs.lean` runs every table on the definitions in `spec/Tau/`, so
the docs, these tables and the specification cannot drift apart unnoticed.

Do not edit this file.
-/

namespace Specify.Tables

open Tau Specify

/-- The outputs of cycles `0` to `n - 1` when the inputs are the list `inp`,
padded with `pad`. -/
def run {σ ι ο : Type} (b : Block σ ι ο) (inp : List ι) (pad : ι) : List ο :=
  b.trace (fun t => inp[t]?.getD pad) inp.length

/-! ## Components -/

/-- Section 2.1. -/
def shiftRegister {σ : Nat → Type} (sr : (n : Nat) → Int → Block (σ n) Int Int) : List Row :=
  [ row "depth 2, reset 0, inputs 10 11 12 13 14"
      (run (sr 2 0) [10, 11, 12, 13, 14] 0) [0, 0, 10, 11, 12],
    row "depth 1, reset 0, inputs 5 6 7"
      (run (sr 1 0) [5, 6, 7] 0) [0, 5, 6] ]

/-- What section 2.1 leaves open. -/
def shiftRegisterDecisions {σ : Nat → Type} (sr : (n : Nat) → Int → Block (σ n) Int Int) :
    List Row :=
  [ row "depth 0 is a wire: the output is the input of the same cycle"
      (run (sr 0 9) [5, 6, 7] 0) [5, 6, 7],
    row "the reset value is a parameter, not always 0"
      (run (sr 2 9) [5, 6, 7] 0) [9, 9, 5] ]

/-- Section 2.2. -/
def accumulator {σ : Type} (acc : Int → Block σ (AccIn Int) Int) : List Row :=
  [ row "add 1, add 2, add 3, hold, clear, add 5, hold"
      (run (acc 0) [.add 1, .add 2, .add 3, .hold, .clear, .add 5, .hold] .hold)
      [0, 1, 3, 6, 6, 0, 5] ]

/-- What section 2.2 leaves open. -/
def accumulatorDecisions {σ : Type} (acc : Int → Block σ (AccIn Int) Int) : List Row :=
  [ row "load replaces the total; the output still shows the total before it"
      (run (acc 0) [.add 4, .load 7, .add 1, .hold] .hold) [0, 4, 7, 8],
    row "clear goes back to the starting value, which need not be 0"
      (run (acc 100) [.add 1, .clear, .hold] .hold) [100, 101, 100] ]

/-- Section 2.3. -/
def mac {σ : Type} (m : Int → Block σ (AccIn (Int × Int)) Int) : List Row :=
  [ row "the dot product of (1, 2, 3) and (4, 5, 6)"
      (run (m 0) [.add (1, 4), .add (2, 5), .add (3, 6), .hold] .hold) [0, 4, 14, 32] ]

/-- What section 2.3 leaves open. -/
def macDecisions {σ : Type} (m : Int → Block σ (AccIn (Int × Int)) Int) : List Row :=
  [ row "load multiplies its pair too"
      (run (m 0) [.load (2, 5), .add (1, 1), .hold] .hold) [0, 10, 11],
    row "a pair with a zero in it adds nothing"
      (run (m 0) [.add (0, 7), .add (3, 0), .add (2, 2), .hold] .hold) [0, 0, 0, 4] ]

/-- Section 2.4. -/
def pipeline {σ : Nat → Type} (pl : (d : Nat) → (Int → Int) → Int → Block (σ d) Int Int) :
    List Row :=
  [ row "depth 2, doubling, reset 0, inputs 1 2 3 4 5"
      (run (pl 2 (· * 2) 0) [1, 2, 3, 4, 5] 0) [0, 0, 2, 4, 6] ]

/-- What section 2.4 leaves open. -/
def pipelineDecisions {σ : Nat → Type}
    (pl : (d : Nat) → (Int → Int) → Int → Block (σ d) Int Int) : List Row :=
  [ row "depth 0 computes in the same cycle"
      (run (pl 0 (· * 2) 0) [1, 2, 3] 0) [2, 4, 6],
    row "the reset value is not passed through the function"
      (run (pl 1 (· + 1) 50) [1, 2] 0) [50, 2] ]

/-- Section 2.5. -/
def memory {σ : List Int → Type}
    (mem : (words : List Int) → Block (σ words) (MemIn Int) (Option Int)) : List Row :=
  [ row "words 10 11: write 7 to 1, read 1, read 0, idle"
      (run (mem [10, 11]) [.write 1 7, .read 1, .read 0, .idle] .idle)
      [none, some 7, some 10, none] ]

/-- What section 2.5 leaves open. -/
def memoryDecisions {σ : List Int → Type}
    (mem : (words : List Int) → Block (σ words) (MemIn Int) (Option Int)) :
    List Row :=
  [ row "a read outside the memory gives nothing"
      (run (mem [10, 11]) [.read 2] .idle) [none],
    row "a write outside the memory changes nothing"
      (run (mem [10, 11]) [.write 5 7, .read 0, .read 1] .idle) [none, some 10, some 11],
    row "the last of two writes to one address wins"
      (run (mem [10, 11]) [.write 0 1, .write 0 2, .read 0] .idle) [none, none, some 2] ]

/-- Section 2.6. -/
def sequencer {σ : Type} (sq : List (Nat × String) → Block σ Unit (List String)) : List Row :=
  [ row "read at 1, add at 3, write at 3"
      (run (sq [(1, "read"), (3, "add"), (3, "write")]) [(), (), (), ()] ())
      [[], ["read"], [], ["add", "write"]] ]

/-- What section 2.6 leaves open. -/
def sequencerDecisions {σ : Type} (sq : List (Nat × String) → Block σ Unit (List String)) :
    List Row :=
  [ row "items due on one cycle come out in program order, not sorted"
      (run (sq [(1, "b"), (0, "x"), (1, "a")]) [(), ()] ()) [["x"], ["b", "a"]],
    row "an item listed twice is issued twice"
      (run (sq [(0, "a"), (0, "a")]) [()] ()) [["a", "a"]] ]

/-- Section 2.7. -/
def repeater {σ : Type} (rp : List (Entry Nat) → Block σ Unit (List Nat)) : List Row :=
  [ row "first issue at 2, two more, one idle cycle between, items 5 6 7"
      (run (rp [{ time := 2, repeats := 2, gap := 1, first := 5, next := (· + 1) }])
        (List.replicate 8 ()) ())
      [[], [], [5], [], [6], [], [7], []] ]

/-- What section 2.7 leaves open. -/
def repeaterDecisions {σ : Type} (rp : List (Entry Nat) → Block σ Unit (List Nat)) :
    List Row :=
  [ row "no idle cycles between issues: one per cycle"
      (run (rp [{ time := 1, repeats := 2, gap := 0, first := 5, next := (· + 1) }])
        (List.replicate 5 ()) ())
      [[], [5], [6], [7], []],
    row "no further issues: issued once"
      (run (rp [{ time := 1, repeats := 0, gap := 3, first := 5, next := (· + 1) }])
        (List.replicate 6 ()) ())
      [[], [5], [], [], [], []],
    row "two entries due on one cycle come out in program order"
      (run (rp [{ time := 1, repeats := 1, gap := 0, first := 50, next := (· + 1) },
                { time := 0, repeats := 1, gap := 0, first := 10, next := (· + 1) }])
        (List.replicate 3 ()) ())
      [[10], [50, 11], [51]] ]

/-- Section 2.8. The array holds the vector `x`; `coeffs[t]` is the list of
coefficients fed to the cells at cycle `t`. -/
def systolicArray {σ : List Int → Type}
    (sa : (x : List Int) → Block (σ x) (List Int) Int) : List Row :=
  [ row "[[1, 2], [3, 4]] times (10, 100), row i fed to cell j at cycle i + j"
      (run (sa [10, 100]) [[1, 0], [3, 2], [0, 4], [0, 0]] [0, 0]) [0, 0, 210, 430] ]

/-- What section 2.8 leaves open. -/
def systolicArrayDecisions {σ : List Int → Type}
    (sa : (x : List Int) → Block (σ x) (List Int) Int) : List Row :=
  [ row "one cell: the product comes out one cycle later"
      (run (sa [10]) [[2], [3], [0]] [0]) [0, 20, 30],
    row "a missing coefficient counts as 0"
      (run (sa [10, 100]) [[1], [3, 2], [0, 4], []] []) [0, 0, 210, 430] ]

/-! ## The machine -/

/-- Section 3.2, one stream going east, after one cycle. `placed p` is the
word, if any, that the slice at position `p` places on the stream in this
cycle. -/
def streamEast (adv : (Nat → Option Int) → List (Option Int) → List (Option Int)) :
    List Row :=
  [ row "every word moves one position east"
      (adv (fun _ => none) [some 1, none, some 3, none]) [none, some 1, none, some 3],
    row "the slice at position 1 places 7"
      (adv (fun p => if p = 1 then some 7 else none) [none, none, none]) [none, some 7, none] ]

/-- What section 3.2 leaves open, going east. -/
def streamEastDecisions (adv : (Nat → Option Int) → List (Option Int) → List (Option Int)) :
    List Row :=
  [ row "the word at the last position is gone"
      (adv (fun _ => none) [none, some 2]) [none, none],
    row "a placed result replaces the word that arrives at its position"
      (adv (fun p => if p = 1 then some 7 else none) [some 1, none]) [none, some 7],
    row "a result placed at a position the stream does not have is dropped"
      (adv (fun p => if p = 5 then some 7 else none) [some 1, none]) [none, some 1] ]

/-- Section 3.2, one stream going west, after one cycle. -/
def streamWest (adv : (Nat → Option Int) → List (Option Int) → List (Option Int)) :
    List Row :=
  [ row "every word moves one position west"
      (adv (fun _ => none) [none, some 1, none, some 3]) [some 1, none, some 3, none],
    row "the slice at position 1 places 7"
      (adv (fun p => if p = 1 then some 7 else none) [none, none, none]) [none, some 7, none] ]

/-- What one instruction did at one slice: a trap, or the stored words
afterwards and the result with its stream. -/
inductive Outcome where
  /-- The slice trapped. -/
  | trap (kind : TrapKind)
  /-- The stored words afterwards, and the result. -/
  | done (words : List Expr) (result : Option (Stream × Expr))
  deriving DecidableEq, Repr

/-- The type of `exec` when words are names. -/
abbrev ExecFn :=
  Sem Expr → Config → Kind → (Stream → Option Expr) → Slice Expr → Instr →
    Except TrapKind (Slice Expr × Option (Stream × Expr))

/-- A machine for the rows below: memory, vector, memory; one stream each way. -/
def tinyMachine : Config where
  kinds := [.mem, .vxm, .mem]
  streams := 1
  memDelay := 1
  vxmDelay := 1
  sxmDelay := 1
  mxmDelay := 1

/-- Stream 0 going east, and going west. -/
def e0 : Stream := ⟨.east, 0⟩

@[inherit_doc e0]
def w0 : Stream := ⟨.west, 0⟩

/-- A slice holding two words, named `a` and `b` below. -/
def twoWords : Slice Expr where
  words := [.init 0 0, .init 0 1]
  x := none
  acc := .zero
  weights := []
  pipe := []

/-- The streams at the slice: east holds a word named `u`, west holds a word
named `v`, every other stream is empty. -/
def reads (tr : Stream) : Option Expr :=
  if tr = e0 then some (.init 1 0) else if tr = w0 then some (.init 1 1) else none

/-- Run one instruction with `ex` at a slice of the given kind. -/
def try1 (ex : ExecFn) (kind : Kind) (i : Instr) : Outcome :=
  match ex exprSem tinyMachine kind reads twoWords i with
  | .ok (sl, r) => .done sl.words r
  | .error k => .trap k

/-- Sections 3.5 and 3.7, for the memory and vector instructions. In the
labels the stored words are `a` and `b`, and the streams hold `u` (east) and
`v` (west). -/
def exec (ex : ExecFn) : List Row :=
  let a : Expr := .init 0 0
  let b : Expr := .init 0 1
  let u : Expr := .init 1 0
  let v : Expr := .init 1 1
  [ row "memory: read 1 to east" (try1 ex .mem (.read 1 e0)) (.done [a, b] (some (e0, b))),
    row "memory: write east at 0" (try1 ex .mem (.write e0 0)) (.done [u, b] none),
    row "vector: relu of east to west" (try1 ex .vxm (.un .relu e0 w0))
      (.done [a, b] (some (w0, .un .relu u))),
    row "vector: east plus west to east" (try1 ex .vxm (.bin .add e0 w0 e0))
      (.done [a, b] (some (e0, .bin .add u v))),
    row "trap: read of address 2" (try1 ex .mem (.read 2 e0)) (.trap .badAddress),
    row "trap: write at address 2" (try1 ex .mem (.write e0 2)) (.trap .badAddress),
    row "trap: read sent to a vector slice" (try1 ex .vxm (.read 0 e0)) (.trap .wrongSlice),
    row "trap: relu sent to a memory slice" (try1 ex .mem (.un .relu e0 w0))
      (.trap .wrongSlice),
    row "trap: reverse, a rearrangement, sent to a vector slice"
      (try1 ex .vxm (.un .reverse e0 w0)) (.trap .wrongSlice),
    row "trap: result to stream 1, which the machine does not have"
      (try1 ex .mem (.read 0 ⟨.east, 1⟩)) (.trap .badStream),
    row "trap: write from an empty stream" (try1 ex .mem (.write ⟨.east, 1⟩ 0))
      (.trap .emptyRead),
    row "trap: add with one operand missing"
      (try1 ex .vxm (.bin .add e0 ⟨.west, 3⟩ e0)) (.trap .emptyRead) ]

/-- What sections 3.5 and 3.7 leave open: which trap is reported when an
instruction is wrong in two ways. -/
def execDecisions (ex : ExecFn) : List Row :=
  [ row "wrong slice and bad stream: wrong slice is reported"
      (try1 ex .vxm (.read 0 ⟨.east, 1⟩)) (.trap .wrongSlice),
    row "bad stream and bad address: bad stream is reported"
      (try1 ex .mem (.read 2 ⟨.east, 1⟩)) (.trap .badStream),
    row "bad address and empty stream on a write: bad address is reported"
      (try1 ex .mem (.write ⟨.east, 1⟩ 2)) (.trap .badAddress),
    row "bad stream and empty stream on a relu: bad stream is reported"
      (try1 ex .vxm (.un .relu ⟨.east, 3⟩ ⟨.west, 1⟩)) (.trap .badStream) ]

/-! ## Kernels -/

/-- The type of "run one statement" when words are names. -/
abbrev StmtFn := Sem Expr → Nat → Env Expr → Stmt → Option (Env Expr)

/-- An environment as plain data: the variables, most recent first, and the
buffers. -/
def view (r : Option (Env Expr)) : Option (List (Var × Expr) × List (List Expr)) :=
  r.map fun env => (env.vars, env.bufs)

/-- The descriptions of `load`, `store` and the one-word and two-word
operations in `compiler/include/tau/Dialect/TauOps.td`. Buffer 0 holds the
words `a` and `b`, buffer 1 holds `c`. -/
def stmt (ex : StmtFn) : List Row :=
  let a : Expr := .init 0 0
  let b : Expr := .init 0 1
  let c : Expr := .init 1 0
  let env : Env Expr := ⟨[], [[a, b], [c]], []⟩
  let env1 : Env Expr := ⟨[(1, b), (0, a)], [[a, b], [c]], []⟩
  [ row "load word 1 of buffer 0 into value 0"
      (view (ex exprSem 0 env (.load 0 0 ⟨1, 0⟩))) (some ([(0, b)], [[a, b], [c]])),
    row "load at [0, 1] on iteration 1: position 0 + 1 * 1"
      (view (ex exprSem 1 env (.load 0 0 ⟨0, 1⟩))) (some ([(0, b)], [[a, b], [c]])),
    row "store value 1 to word 0 of buffer 1"
      (view (ex exprSem 0 env1 (.store 1 1 ⟨0, 0⟩)))
      (some ([(1, b), (0, a)], [[a, b], [b]])),
    row "relu of value 0 into value 2"
      (view (ex exprSem 0 env1 (.un 2 .relu 0)))
      (some ([(2, .un .relu a), (1, b), (0, a)], [[a, b], [c]])),
    row "value 0 plus value 1 into value 2"
      (view (ex exprSem 0 env1 (.bin 2 .add 0 1)))
      (some ([(2, .bin .add a b), (1, b), (0, a)], [[a, b], [c]])) ]

/-- What the dialect's descriptions leave open. -/
def stmtDecisions (ex : StmtFn) : List Row :=
  let a : Expr := .init 0 0
  let b : Expr := .init 0 1
  let c : Expr := .init 1 0
  let env : Env Expr := ⟨[], [[a, b], [c]], []⟩
  let env1 : Env Expr := ⟨[(0, b), (0, a)], [[a, b], [c]], []⟩
  [ row "a load outside its buffer fails"
      (view (ex exprSem 0 env (.load 0 0 ⟨2, 0⟩))) none,
    row "a load from a buffer that does not exist fails"
      (view (ex exprSem 0 env (.load 0 5 ⟨0, 0⟩))) none,
    row "a store outside its buffer fails; the buffer does not grow"
      (view (ex exprSem 0 env1 (.store 0 1 ⟨1, 0⟩))) none,
    row "a statement that uses a value with no definition fails"
      (view (ex exprSem 0 env (.un 1 .relu 0))) none,
    row "a value defined twice has its most recent definition"
      (view (ex exprSem 0 env1 (.store 0 1 ⟨0, 0⟩)))
      (some ([(0, b), (0, a)], [[a, b], [b]])) ]

/-! ## Pins -/

/-- The type of "the event of a pinned statement": the iteration, the pin,
the statement, and the environment after the statement has run. -/
abbrev PinFn := Nat → Idx → Stmt → Env Expr → Option (Event Expr)

/-- Programs 5. Buffer 0 holds the words `a` and `b`; value 0 is `a` and
value 1 is the relu of `a`. -/
def pin (ev : PinFn) : List Row :=
  let a : Expr := .init 0 0
  let b : Expr := .init 0 1
  let env : Env Expr := ⟨[(1, .un .relu a), (0, a)], [[a, b], [a, a, a, a]], []⟩
  [ row "relu of a, at 3"
      (ev 0 ⟨3, 0⟩ (.un 1 .relu 0) env) (some ⟨3, none, .un .relu a⟩),
    row "store a to word 0 of buffer 1, at 6"
      (ev 0 ⟨6, 0⟩ (.store 0 1 ⟨0, 0⟩) env) (some ⟨6, some (1, 0), a⟩),
    row "load word 1 of buffer 0 into value 2, at 2"
      (ev 0 ⟨2, 0⟩ (.load 2 0 ⟨1, 0⟩) ⟨[(2, b), (0, a)], env.bufs, []⟩)
      (some ⟨2, none, b⟩),
    row "relu of a, at 5 every 4, iteration 2"
      (ev 2 ⟨5, 4⟩ (.un 1 .relu 0) env) (some ⟨13, none, .un .relu a⟩),
    row "store a to word i of buffer 1, at 9 every 4, iteration 3"
      (ev 3 ⟨9, 4⟩ (.store 0 1 ⟨0, 1⟩) env) (some ⟨21, some (1, 3), a⟩) ]

/-- What Programs 5 leaves open. -/
def pinDecisions (ev : PinFn) : List Row :=
  let a : Expr := .init 0 0
  let env : Env Expr := ⟨[(1, .un .relu a), (0, a)], [[a], [a]], []⟩
  [ row "a matrix product: the word is its result"
      (ev 0 ⟨7, 0⟩ (.matvec 1 0 0 ⟨0, 0⟩ 1) env) (some ⟨7, none, .un .relu a⟩),
    row "a statement that is pinned twice: the inner statement's word"
      (ev 0 ⟨7, 0⟩ (.pin ⟨2, 0⟩ (.un 1 .relu 0)) env) (some ⟨7, none, .un .relu a⟩),
    row "a statement whose word has no value: no event"
      (ev 0 ⟨7, 0⟩ (.un 5 .relu 0) env) none ]

/-- The type of "run a source program on names": the final buffers and the
pinned words, or `none` if it cannot be run. -/
abbrev SourceFn := Source → List (List Expr) → Option (List (List Expr) × List (Event Expr))

/-- Programs 4. Buffers 0, 1 and 2 hold `a`, `b` and `c`. -/
def calls (run : SourceFn) : List Row :=
  let a : Expr := .init 0 0
  let b : Expr := .init 1 0
  let c : Expr := .init 2 0
  let k : Source := .ofKernel
    [ .stmt (.load 0 0 ⟨0, 0⟩), .stmt (.pin ⟨3, 0⟩ (.un 1 .relu 0)),
      .stmt (.store 1 1 ⟨0, 0⟩) ]
  let r : Expr := .un .relu a
  let rr : Expr := .un .relu r
  [ row "call K on buffers 0 and 2"
      (run (.call k [0, 2] 0 .done) [[a], [b], [c]])
      (some ([[a], [b], [r]], [⟨3, none, r⟩])),
    row "then call K on buffers 2 and 1, from cycle 10"
      (run (.call k [0, 2] 0 (.call k [2, 1] 10 .done)) [[a], [b], [c]])
      (some ([[a], [rr], [r]], [⟨13, none, rr⟩, ⟨3, none, r⟩])),
    row "a call that passes one buffer twice cannot be run"
      (run (.call k [0, 0] 0 .done) [[a], [b], [c]]) none ]

/-- The type of "what the machine issues": the machine, the program, the number
of cycles and the starting memories. -/
abbrev IssuesFn := Config → Program → Nat → List (List Expr) → List (Issue Expr)

/-- Machine 3.9: the three slices read, apply relu and write. -/
def issued (f : IssuesFn) : List Row :=
  let a : Expr := .init 0 0
  let prog : Program :=
    [ .once 0 0 (.read 0 e0), .once 1 3 (.un .relu e0 e0), .once 2 6 (.write e0 0) ]
  [ row "cycles 0, 3 and 6"
      (f tinyMachine prog 7 [[a], [], [.fill]])
      [ ⟨0, 0, none, a⟩, ⟨3, 1, none, .un .relu a⟩, ⟨6, 2, some 0, .un .relu a⟩ ] ]

/-! ## The image -/

/-- Machine 3.10: streams and integers as numbers. -/
def numbers (stream : Stream → Nat) (int : Int → Nat) : List Row :=
  [ row "stream 0 going east" (stream ⟨.east, 0⟩) 0,
    row "stream 0 going west" (stream ⟨.west, 0⟩) 1,
    row "stream 3 going east" (stream ⟨.east, 3⟩) 6,
    row "stream 3 going west" (stream ⟨.west, 3⟩) 7,
    row "the integer 0" (int 0) 0,
    row "the integer 1" (int 1) 2,
    row "the integer -1" (int (-1)) 1,
    row "the integer 5" (int 5) 10,
    row "the integer -5" (int (-5)) 9 ]

/-- The same table read the other way. -/
def numbersBack (stream : Nat → Stream) (int : Nat → Int) : List Row :=
  [ row "0 as a stream" (stream 0) ⟨.east, 0⟩,
    row "1 as a stream" (stream 1) ⟨.west, 0⟩,
    row "6 as a stream" (stream 6) ⟨.east, 3⟩,
    row "7 as a stream" (stream 7) ⟨.west, 3⟩,
    row "0 as an integer" (int 0) 0,
    row "2 as an integer" (int 2) 1,
    row "1 as an integer" (int 1) (-1),
    row "10 as an integer" (int 10) 5,
    row "9 as an integer" (int 9) (-5) ]

/-- Machine 3.10: entries as numbers. The slice of an entry is not stored;
these are all at slice 0. -/
def entries (enc : TimedEntry → List Nat) : List Row :=
  let w1 : Stream := ⟨.west, 0⟩
  [ row "read address 0 to east 0 on cycle 2"
      (enc (.once 0 2 (.read 0 e0))) [2, 0, 0, 0, 0, 0, 0],
    row "the same, 3 more times, 3 idle cycles apart, address growing by 1"
      (enc { slice := 0, time := 2, instr := .read 0 e0, repeats := 3, gap := 3, stride := 1 })
      [2, 3, 3, 1, 0, 0, 0],
    row "write west 0 at address 4 on cycle 9"
      (enc (.once 0 9 (.write w1 4))) [9, 0, 0, 0, 1, 1, 4],
    row "relu of east 0 to west 0 on cycle 6"
      (enc (.once 0 6 (.un .relu e0 w1))) [6, 0, 0, 0, 2, 0, 1, 0],
    row "add 5 to east 1, to east 1, on cycle 7"
      (enc (.once 0 7 (.un (.addi 5) ⟨.east, 1⟩ ⟨.east, 1⟩))) [7, 0, 0, 0, 2, 2, 2, 5, 10],
    row "east 1 minus west 2 to east 0 on cycle 8"
      (enc (.once 0 8 (.bin .sub ⟨.east, 1⟩ ⟨.west, 2⟩ e0))) [8, 0, 0, 0, 3, 1, 2, 5, 0],
    row "the constant 3, -4 to west 2 on cycle 4"
      (enc (.once 0 4 (.const [3, -4] ⟨.west, 2⟩))) [4, 0, 0, 0, 7, 5, 2, 6, 7] ]

/-! ## Passes -/

/-- Two lists of statements that differ only in how values are numbered. -/
def sameUpToNumbering (a b : List Stmt) : Bool :=
  match Tools.renumber [] 0 a, Tools.renumber [] 0 b with
  | some x, some y => x == y
  | _, _ => false

/-- A loop that copies buffer 0 to buffer 1 through a relu, two words. -/
def reluLoop : Kernel :=
  [.loop 2 [.load 0 0 ⟨0, 1⟩, .un 1 .relu 0, .store 1 1 ⟨0, 1⟩]]

/-- `compiler/lib/Passes/Unroll.cpp`. -/
def unroll (un : Kernel → List Stmt) : List Row :=
  [ row "a loop of two iterations becomes two copies, with positions filled in"
      (un reluLoop)
      [.load 0 0 ⟨0, 0⟩, .un 1 .relu 0, .store 1 1 ⟨0, 0⟩,
       .load 0 0 ⟨1, 0⟩, .un 1 .relu 0, .store 1 1 ⟨1, 0⟩],
    row "the check accepts the unrolled kernel for the original"
      (checkKernels reluLoop ((un reluLoop).map Item.stmt) [2, 2]) true,
    row "statements before and after a loop stay in place"
      ((un [.stmt (.load 5 0 ⟨0, 0⟩), .loop 1 [.un 6 .relu 5], .stmt (.store 6 1 ⟨0, 0⟩)]).length)
      3 ]

/-- What `Unroll.cpp` leaves open, or does differently from its Lean copy. -/
def unrollDecisions (un : Kernel → List Stmt) : List Row :=
  [ row "a loop of no iterations disappears"
      (un [.loop 0 [.load 0 0 ⟨0, 1⟩]]) [],
    row "outside a loop the iteration is 0, and the stride is written out as 0"
      (un [.stmt (.load 0 0 ⟨2, 5⟩)]) [.load 0 0 ⟨2, 0⟩] ]

/-- `compiler/lib/Passes/Simplify.cpp`. Each row gives a kernel and the
kernel the pass should make of it, up to the numbering of values. -/
def simplify (sp : Kernel → Kernel) : List Row :=
  let same (k : Kernel) (want : List Stmt) : Bool :=
    sameUpToNumbering (Kernel.unroll (sp k)) want
  let reluRelu : Kernel :=
    [.stmt (.load 0 0 ⟨0, 0⟩), .stmt (.un 1 .relu 0), .stmt (.un 2 .relu 1),
     .stmt (.store 2 1 ⟨0, 0⟩)]
  [ row "relu of relu: the second relu goes, and the store uses the first"
      (same reluRelu [.load 0 0 ⟨0, 0⟩, .un 1 .relu 0, .store 1 1 ⟨0, 0⟩]) true,
    row "the check accepts the simplified kernel for the original"
      (checkKernels reluRelu (sp reluRelu) [1, 1]) true,
    row "max of a value with itself: the max goes"
      (same [.stmt (.load 0 0 ⟨0, 0⟩), .stmt (.bin 1 .max 0 0), .stmt (.store 1 1 ⟨0, 0⟩)]
        [.load 0 0 ⟨0, 0⟩, .store 0 1 ⟨0, 0⟩]) true,
    row "min of a value with itself: the min goes"
      (same [.stmt (.load 0 0 ⟨0, 0⟩), .stmt (.bin 1 .min 0 0), .stmt (.store 1 1 ⟨0, 0⟩)]
        [.load 0 0 ⟨0, 0⟩, .store 0 1 ⟨0, 0⟩]) true,
    row "nothing to simplify: the kernel is unchanged"
      (same [.stmt (.load 0 0 ⟨0, 0⟩), .stmt (.un 1 .relu 0), .stmt (.store 1 1 ⟨0, 0⟩)]
        [.load 0 0 ⟨0, 0⟩, .un 1 .relu 0, .store 1 1 ⟨0, 0⟩]) true,
    row "inside a loop"
      (same [.loop 2 [.load 0 0 ⟨0, 1⟩, .un 1 .relu 0, .un 2 .relu 1, .store 2 1 ⟨0, 1⟩]]
        [.load 0 0 ⟨0, 0⟩, .un 1 .relu 0, .store 1 1 ⟨0, 0⟩,
         .load 2 0 ⟨1, 0⟩, .un 3 .relu 2, .store 3 1 ⟨1, 0⟩]) true ]

/-- What `Simplify.cpp` leaves open. -/
def simplifyDecisions (sp : Kernel → Kernel) : List Row :=
  let same (k : Kernel) (want : List Stmt) : Bool :=
    sameUpToNumbering (Kernel.unroll (sp k)) want
  [ row "three relus in a row become one"
      (same [.stmt (.load 0 0 ⟨0, 0⟩), .stmt (.un 1 .relu 0), .stmt (.un 2 .relu 1),
             .stmt (.un 3 .relu 2), .stmt (.store 3 1 ⟨0, 0⟩)]
        [.load 0 0 ⟨0, 0⟩, .un 1 .relu 0, .store 1 1 ⟨0, 0⟩]) true,
    row "max of two loads of the same word stays: they are different values"
      (same [.stmt (.load 0 0 ⟨0, 0⟩), .stmt (.load 1 0 ⟨0, 0⟩), .stmt (.bin 2 .max 0 1),
             .stmt (.store 2 1 ⟨0, 0⟩)]
        [.load 0 0 ⟨0, 0⟩, .load 1 0 ⟨0, 0⟩, .bin 2 .max 0 1, .store 2 1 ⟨0, 0⟩]) true,
    row "max of a relu of relu with the first relu: both rewrites apply"
      (same [.stmt (.load 0 0 ⟨0, 0⟩), .stmt (.un 1 .relu 0), .stmt (.un 2 .relu 1),
             .stmt (.bin 3 .max 1 2), .stmt (.store 3 1 ⟨0, 0⟩)]
        [.load 0 0 ⟨0, 0⟩, .un 1 .relu 0, .store 1 1 ⟨0, 0⟩]) true ]

/-! ## A rule for schedules -/

/-- Every instruction the program issues, as slice, cycle and instruction. -/
def issues (c : Compiled) : List (Nat × Nat × Instr) :=
  (List.range c.cfg.kinds.length).flatMap fun p =>
    (List.range c.cycles).flatMap fun t =>
      (c.prog.dueAt p t).map fun i => (p, t, i)

/-- The streams an instruction reads. -/
def operands : Instr → List Stream
  | .read _ _ => []
  | .write src _ => [src]
  | .un _ src _ => [src]
  | .bin _ a b _ => [a, b]
  | .load src => [src]
  | .mac _ src => [src]
  | .emit _ => []
  | .const _ _ => []
  | .sel m a b _ => [m, a, b]
  | .seed src => [src]
  | .install _ src => [src]
  | .macw _ => []

/-- The stream an instruction places its result on, if it has a result. -/
def result : Instr → Option Stream
  | .read _ dst => some dst
  | .un _ _ dst => some dst
  | .bin _ _ _ dst => some dst
  | .emit dst => some dst
  | .const _ dst => some dst
  | .sel _ _ _ dst => some dst
  | _ => none

/-- What the machine, run on names, says about timing: `some true` if it
reads an empty stream slot, `some false` if it runs to the end, and `none` if
it traps for another reason, in which case it says nothing about timing. -/
def machineSays (c : Compiled) : Option Bool :=
  match execute exprSem c.cfg c.prog c.cycles (image c.map c.memSizes Expr.init .fill) with
  | .error t => if t.kind == .emptyRead then some true else none
  | .ok _ => some false

/-- Whether the machine, run on names, reads an empty stream slot. -/
def machineReadsEmpty (c : Compiled) : Bool := machineSays c == some true

/-- A compiled program on `tinyMachine` with one word in each memory. -/
def onTiny (prog : Program) (cycles : Nat) : Compiled where
  cfg := tinyMachine
  memSizes := [1, 0, 1]
  map := [⟨0, 0, 1⟩, ⟨2, 0, 1⟩]
  prog := prog
  cycles := cycles

/-- Section 3.4, as a rule on programs. -/
def onTime (rule : Compiled → Bool) : List Row :=
  [ row "copy west to east: read at 0, write at slice 2 on cycle 4"
      (rule (onTiny [.once 0 0 (.read 0 e0), .once 2 4 (.write e0 0)] 5)) true,
    row "the write one cycle late"
      (rule (onTiny [.once 0 0 (.read 0 e0), .once 2 5 (.write e0 0)] 6)) false,
    row "the write one cycle early"
      (rule (onTiny [.once 0 0 (.read 0 e0), .once 2 3 (.write e0 0)] 5)) false,
    row "a relu on the way: read at 0, relu at slice 1 on cycle 3, write at 2 on cycle 6"
      (rule (onTiny [.once 0 0 (.read 0 e0), .once 1 3 (.un .relu e0 e0),
                     .once 2 6 (.write e0 0)] 7)) true,
    row "going west: read at slice 2, write at slice 0 on cycle 4"
      (rule (onTiny [.once 2 0 (.read 0 w0), .once 0 4 (.write w0 0)] 5)) true,
    row "the word is going the wrong way"
      (rule (onTiny [.once 2 0 (.read 0 e0), .once 0 4 (.write e0 0)] 5)) false,
    row "the rule agrees with the machine on all of the above"
      ([ onTiny [.once 0 0 (.read 0 e0), .once 2 4 (.write e0 0)] 5,
         onTiny [.once 0 0 (.read 0 e0), .once 2 5 (.write e0 0)] 6,
         onTiny [.once 0 0 (.read 0 e0), .once 2 3 (.write e0 0)] 5,
         onTiny [.once 2 0 (.read 0 e0), .once 0 4 (.write e0 0)] 5 ].all fun c =>
        rule c == !machineReadsEmpty c) true ]

/-- Every copy of `c` in which one instruction that reads a stream is issued
one cycle later. None of them should pass a rule for timing. -/
def delayedCopies (c : Compiled) : List Compiled :=
  (List.range c.prog.length).filterMap fun n =>
    match c.prog[n]? with
    | some e =>
      if (operands e.instr).isEmpty then none
      else some { c with prog := c.prog.set n { e with time := e.time + 1 },
                         cycles := c.cycles + 1 }
    | none => none

/-- Read the compiled program in a file that `tauc` wrote. -/
def readCompiled (path : String) : IO Compiled := do
  match ← Json.orFail path (Json.stage (← Json.readFile path)) with
  | .compiled c => pure c
  | _ => throw (IO.userError s!"{path}: not a compiled program")

/-- Read a kernel file that `tauc` wrote. -/
def readKernel (path : String) : IO Kernel := do
  pure (← Json.orFail path (Json.kernel (← Json.readFile path))).2

/-- Compare a rule with the machine on the compiler's output for one example.
The rule must accept the scheduled and the finished program. On every copy
with one instruction delayed it must agree with the machine, except where the
machine traps for a reason other than an empty read. -/
def onTimeOnExample (rule : Compiled → Bool) (dir : String) : IO (List Row) := do
  let mut rows := []
  for file in ["scheduled.json", "compiled.json"] do
    let c ← readCompiled s!"{dir}/{file}"
    rows := rows ++ [row s!"{dir}/{file} is accepted" (rule c) true]
    let copies := delayedCopies c
    let wrong := copies.filter fun d =>
      match machineSays d with
      | some empty => rule d == empty
      | none => false
    rows := rows ++
      [row s!"{dir}/{file}: copies with one instruction delayed, where the rule and the machine differ"
        wrong.length 0]
  pure rows

/-- Compare a copy of `tau-unroll` with the compiler on one example. -/
def unrollOnExample (un : Kernel → List Stmt) (dir : String) : IO (List Row) := do
  let before ← readKernel s!"{dir}/simplified.json"
  let after ← readKernel s!"{dir}/unrolled.json"
  pure [row s!"{dir}: the same kernel as the compiler's, up to numbering"
    (sameUpToNumbering (un before) (Kernel.unroll after)) true]

/-- Compare a copy of `tau-simplify` with the compiler on one example. -/
def simplifyOnExample (sp : Kernel → Kernel) (dir : String) : IO (List Row) := do
  let before ← readKernel s!"{dir}/inlined.json"
  let after ← readKernel s!"{dir}/simplified.json"
  pure [row s!"{dir}: the same kernel as the compiler's, up to numbering"
    (sameUpToNumbering (Kernel.unroll (sp before)) (Kernel.unroll after)) true]

/-! ## Reading a pass in C++ -/

/-- What a group of lines of a C++ pass is about. -/
inductive About where
  /-- Not answered yet. -/
  | unanswered
  /-- About MLIR: includes, the pass class, values, builders. A copy of the
  pass in Lean has nothing for it. -/
  | mlir
  /-- About the kernel: what the pass does to the program. -/
  | kernel
  /-- A limit: something the pass refuses to handle. -/
  | limit
  deriving DecidableEq, Repr, Inhabited

/-- An answer for one group of lines: what it is about, and the name of the
definition in `spec/Tau/` that says the same thing, or `""` if there is none. -/
structure Answer where
  /-- What the lines are about. -/
  about : About
  /-- The Lean definition that says the same, without the `Tau.` in front. -/
  lean : String := ""
  deriving DecidableEq, Repr, Inhabited

/-- One row for an answer about a group of lines. -/
def readRow (lines : String) (got want : Answer) : Row :=
  if got.about != want.about then
    ⟨s!"lines {lines}: what they are about (you said {repr got.about})", false⟩
  else if got.lean.trimAscii.toString != want.lean then
    ⟨s!"lines {lines}: the Lean definition that says the same (you said \"{got.lean}\")", false⟩
  else ⟨s!"lines {lines}", true⟩

/-- `compiler/lib/Passes/Unroll.cpp`, group by group. -/
def readUnroll (a16 a29 a35 a54 a67 a72 a73 a82 a89 : Answer) : List Row :=
  [ readRow "16 to 24" a16 ⟨.mlir, ""⟩,
    readRow "29 to 33" a29 ⟨.kernel, "Idx.inst"⟩,
    readRow "35 to 52" a35 ⟨.kernel, "Stmt.inst"⟩,
    readRow "54 to 60" a54 ⟨.mlir, ""⟩,
    readRow "67 to 70" a67 ⟨.limit, "Item"⟩,
    readRow "72, 74 and 79" a72 ⟨.kernel, "unrollLoop"⟩,
    readRow "73" a73 ⟨.mlir, ""⟩,
    readRow "82" a82 ⟨.kernel, "Item.unroll"⟩,
    readRow "89 to 91" a89 ⟨.mlir, ""⟩ ]

/-- Where the C++ pass and its Lean copy differ, and one line of the
scheduler. -/
def readDifferences (newNames nested outside : Option Bool) (timingLine : Nat) : List Row :=
  [ ⟨"new value names", newNames == some true⟩,
    ⟨"a loop inside a loop", nested == some false⟩,
    ⟨"a statement outside every loop", outside == some true⟩,
    ⟨"the line of Schedule.cpp that is the timing rule", timingLine == 301⟩ ]

/-- The lines of the C++ that the reading exercise quotes. If the C++ moves,
`course/tests/CourseTest/SpecSolutions.lean` fails here and the exercise has to be
renumbered. -/
def quotedLines : List (String × Nat × String) :=
  [ ("compiler/lib/Passes/Unroll.cpp", 16, "#include"),
    ("compiler/lib/Passes/Unroll.cpp", 31, "op.setBase(op.getBase() + op.getStride() * k)"),
    ("compiler/lib/Passes/Unroll.cpp", 36, "getAttrOfType<IntegerAttr>(\"at\")"),
    ("compiler/lib/Passes/Unroll.cpp", 50, "tau::AffineOp"),
    ("compiler/lib/Passes/Unroll.cpp", 54, "struct UnrollPass"),
    ("compiler/lib/Passes/Unroll.cpp", 67, "getParentOp"),
    ("compiler/lib/Passes/Unroll.cpp", 72, "k < n"),
    ("compiler/lib/Passes/Unroll.cpp", 73, "IRMapping mapping"),
    ("compiler/lib/Passes/Unroll.cpp", 79, "builder.clone(op, mapping)"),
    ("compiler/lib/Passes/Unroll.cpp", 82, "loop.erase()"),
    ("compiler/lib/Passes/Unroll.cpp", 89, "createUnrollPass"),
    ("compiler/lib/Passes/Schedule.cpp", 301, "return delay + 1 + std::abs(q - p);") ]

/-- Whether every quoted line is still where the exercise says it is. -/
def quotedLinesHold : IO (List Row) := do
  let mut rows := []
  for (file, n, text) in quotedLines do
    let lines := (← IO.FS.readFile file).splitOn "\n"
    let line := lines[n - 1]?.getD ""
    rows := rows ++ [⟨s!"{file}, line {n} should contain: {text}", (line.splitOn text).length > 1⟩]
  pure rows

/-! ## What makes a specification provable -/

/-- A step that computes `relu`, for any meaning of the operations. -/
def plain {V : Type} (S : Sem V) (x : V) : V := S.un .relu x

/-- The same, except that it first looks at the word: a zero word becomes the
constant 7. It needs to compare values, which `plain` does not. -/
def peeking {V : Type} [DecidableEq V] (S : Sem V) (x : V) : V :=
  if x = S.zero then S.const [7] else S.un .relu x

/-- A memory that answers 0 where `Tau.memory` answers "nothing". -/
def memory0 (words : List Int) : Block (List Int) (MemIn Int) Int where
  init := words
  step s c :=
    match c with
    | .idle => (s, 0)
    | .read a => (s, s[a]?.getD 0)
    | .write a x => (if a < s.length then s.set a x else s, 0)

/-- A shift register that is right at every depth but one. -/
def shiftRegisterButOne (n : Nat) (reset : Int) : Block (List Int) Int Int where
  init := List.replicate (if n % 4 = 3 ∧ n / 4 = 0 then 2 else n) reset
  step s x := ((x :: s).dropLast, (x :: s).getLast?.getD x)

/-- The three tasks of `course/Specify/Method/Provable.lean`. -/
def provable (giveaway : List Int) (badDepth : Nat) (lookalike : List Int × Nat) :
    List Row :=
  let w : Word 2 := Word.ofInts giveaway
  [ row "on names both steps give relu of the input"
      (peeking exprSem (.init 0 0) == plain exprSem (.init 0 0)) true,
    row "1. your word has two lanes" giveaway.length 2,
    row "1. your word makes the step that looks at its value do something else"
      (peeking (wordSem 2) w != plain (wordSem 2) w) true,
    row "2. at your depth the candidate and the shift register differ"
      (run (shiftRegisterButOne badDepth 9) [5, 6, 7] 0 !=
        run (Tau.shiftRegister badDepth 9) [5, 6, 7] 0) true,
    row "3. your address is inside the memory"
      (lookalike.1.length == 2 && decide (lookalike.2 < 2)) true,
    row "3. with these words, reading your address and reading address 5 look the same"
      (run (memory0 lookalike.1) [.read lookalike.2] .idle ==
        run (memory0 lookalike.1) [.read 5] .idle) true ]

